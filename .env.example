# Copy to .env and replace all CHANGE_ME values. Never commit .env.
DATABASE_PASSWORD=CHANGE_ME
# At least 32 random bytes encoded as base64, e.g. openssl rand -base64 48
JWT_SECRET=CHANGE_ME
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=CHANGE_ME_use_at_least_12_characters
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# false is only for local HTTP; use true with HTTPS.
SECURE_COOKIES=false
# Optional: used only by node scripts/seed-demo.mjs
DEMO_PASSWORD=CHANGE_ME_use_a_different_12_character_password
